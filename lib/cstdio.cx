// cstdio.cx
// C 标准输入输出的 clux 绑定，对应 <stdio.h>

import cstddef    // size_t

exprdef EOF = -1
exprdef SEEK_SET = 0
exprdef SEEK_CUR = 1
exprdef SEEK_END = 2

exprdef _IOFBF = 0
exprdef _IOLBF = 1
exprdef _IONBF = 2

extern "C" {
    // 标准流
    var void-* stdin
    var void-* stdout
    var void-* stderr

    // 文件操作
    fopen(char-* filename char-* mode) void-* r{}
    freopen(char-* filename char-* mode void-* stream) void-* r{}
    fclose(void-* stream) int r{}
    fflush(void-* stream) int r{}
    setbuf(void-* stream char-* buf) {}
    setvbuf(void-* stream char-* buf int mode size_t size) int r{}

    // 格式化输出
    printf(char-* fmt ...) int r{}
    fprintf(void-* stream char-* fmt ...) int r{}
    sprintf(char-* buf char-* fmt ...) int r{}
    snprintf(char-* buf size_t size char-* fmt ...) int r{}

    // 格式化输入
    scanf(char-* fmt ...) int r{}
    fscanf(void-* stream char-* fmt ...) int r{}
    sscanf(char-* s char-* fmt ...) int r{}

    // 字符输出
    putchar(int c) int r{}
    putc(int c void-* stream) int r{}
    fputc(int c void-* stream) int r{}
    puts(char-* s) int r{}
    fputs(char-* s void-* stream) int r{}

    // 字符输入
    getchar() int r{}
    getc(void-* stream) int r{}
    fgetc(void-* stream) int r{}
    ungetc(int c void-* stream) int r{}
    fgets(char-* s int n void-* stream) char-* r{}
    // gets 已从 C11 移除，不声明

    // 二进制 I/O
    fread(void-* ptr size_t size size_t nmemb void-* stream) size_t r{}
    fwrite(void-* ptr size_t size size_t nmemb void-* stream) size_t r{}

    // 文件定位
    fseek(void-* stream long offset int whence) int r{}
    ftell(void-* stream) long r{}
    rewind(void-* stream) {}
    fgetpos(void-* stream void-* pos) int r{}
    fsetpos(void-* stream void-* pos) int r{}

    // 错误与状态
    clearerr(void-* stream) {}
    feof(void-* stream) int r{}
    ferror(void-* stream) int r{}
    perror(char-* s) {}

    // 文件管理
    remove(char-* filename) int r{}
    rename(char-* oldname char-* newname) int r{}
    tmpfile() void-* r{}
    tmpnam(char-* s) char-* r{} // 不安全
}