// cfenv.cx
// C 浮点环境，对应 <fenv.h>
// 目标平台：x86_64 Linux (glibc)

// 类型

typedef fexcept_t = ushort

// 异常标志（fexcept_t 位掩码）

exprdef FE_INVALID   = 0x01
exprdef FE_DIVBYZERO = 0x04
exprdef FE_OVERFLOW  = 0x08
exprdef FE_UNDERFLOW = 0x10
exprdef FE_INEXACT   = 0x20
exprdef FE_ALL_EXCEPT = 0x3D

// 舍入模式

exprdef FE_TONEAREST  = 0x0000
exprdef FE_DOWNWARD   = 0x0400
exprdef FE_UPWARD     = 0x0800
exprdef FE_TOWARDZERO = 0x0C00

// 默认环境

exprdef FE_DFL_ENV = 0xFFFFFFFFFFFFFFFF

// C 函数

extern "C" {
    // 异常标志操作
    feclearexcept(int excepts) int r{}
    fegetexceptflag(fexcept_t-& flagp int excepts) int r{}
    feraiseexcept(int excepts) int r{}
    fesetexceptflag(fexcept_t-& flagp int excepts) int r{}
    fetestexcept(int excepts) int r{}

    // 舍入模式
    fegetround() int r{}
    fesetround(int rounding_mode) int r{}

    // 完整环境
    fegetenv(fenv_t-& envp) int r{}
    feholdexcept(fenv_t-& envp) int r{}
    fesetenv(fenv_t-& envp) int r{}
    feupdateenv(fenv_t-& envp) int r{}
}

// LLVMIR 符号声明

extern "LLVMIR" {
    fenv_t{}
}

// IR 实现

keep `
; x86_64 glibc fenv_t 布局：
; struct {
;     unsigned short __control_word;  ; offset 0,  2 bytes
;     unsigned short __unused1;       ; offset 2,  2 bytes
;     unsigned short __status_word;   ; offset 4,  2 bytes
;     unsigned short __unused2;       ; offset 6,  2 bytes
;     unsigned short __tags;          ; offset 8,  2 bytes
;     unsigned short __unused3;       ; offset 10, 2 bytes
;     unsigned int   __eip;           ; offset 12, 4 bytes
;     unsigned short __cs_selector;   ; offset 16, 2 bytes
;     unsigned int   __opcode : 11;   ; offset 18, 2 bytes (bitfield)
;     unsigned int   __unused4 : 5;
;     unsigned int   __data_offset;   ; offset 20, 4 bytes
;     unsigned short __data_selector; ; offset 24, 2 bytes
;     unsigned short __unused5;       ; offset 26, 2 bytes
;     unsigned int   __mxcsr;         ; offset 28, 4 bytes
; };                                  ; total 32 bytes

%fenv_t = type {
    i16, i16, i16, i16, i16, i16,
    i32, i16, i16, i32, i16, i16, i32
}
`