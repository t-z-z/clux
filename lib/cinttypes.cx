exprdef SCNiLEAST32 = "i"
exprdef SCNoLEAST32 = "o"
exprdef SCNuLEAST32 = "u"
exprdef SCNxLEAST32 = "x"

exprdef SCNdLEAST64 = "ld"
exprdef SCNiLEAST64 = "li"
exprdef SCNoLEAST64 = "lo"
exprdef SCNuLEAST64 = "lu"
exprdef SCNxLEAST64 = "lx"

// 最快宽度
exprdef SCNdFAST8 = "hhd"
exprdef SCNiFAST8 = "hhi"
exprdef SCNoFAST8 = "hho"
exprdef SCNuFAST8 = "hhu"
exprdef SCNxFAST8 = "hhx"

exprdef SCNdFAST16 = "hd"
exprdef SCNiFAST16 = "hi"
exprdef SCNoFAST16 = "ho"
exprdef SCNuFAST16 = "hu"
exprdef SCNxFAST16 = "hx"

exprdef SCNdFAST32 = "d"
exprdef SCNiFAST32 = "i"
exprdef SCNoFAST32 = "o"
exprdef SCNuFAST32 = "u"
exprdef SCNxFAST32 = "x"

exprdef SCNdFAST64 = "ld"
