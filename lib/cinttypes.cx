exprdef SCNoFAST64 = "lo"
exprdef SCNuFAST64 = "lu"
exprdef SCNxFAST64 = "lx"

// 指针宽度
exprdef SCNdPTR = "ld"
exprdef SCNiPTR = "li"
exprdef SCNoPTR = "lo"
exprdef SCNuPTR = "lu"
exprdef SCNxPTR = "lx"

// 最大宽度
exprdef SCNdMAX = "ld"
exprdef SCNiMAX = "li"
exprdef SCNoMAX = "lo"
exprdef SCNuMAX = "lu"
exprdef SCNxMAX = "lx"

// 除法
extern "LLVMIR" {
    _imaxdiv_t{}
    _imaxdiv(long numer long denom) _imaxdiv_t r{}
    _imaxdiv_quot(_imaxdiv_t-& p) long r{}
    _imaxdiv_rem(_imaxdiv_t-& p) long r{}
}

// 标量函数
extern "C" {
    imaxabs(long j) long r{}
    strtoimax(const char-* nptr char-** endptr int base) long r{}
    strtoumax(const char-* nptr char-** endptr int base) ulong r{}
    // wcstoimax / wcstoumax 不声明：clux 没有宽字符
}

// LLVM IR 实现
keep `
%_imaxdiv_t = type { i64, i64 }

define %_imaxdiv_t @_imaxdiv(i64 %a0, i64 %a1) #0 {
entry:
  %q = sdiv i64 %a0, %a1
  %r = srem i64 %a0, %a1

  %tmp0 = insertvalue %_imaxdiv_t poison, i64 %q, 0
  %tmp1 = insertvalue %_imaxdiv_t %tmp0, i64 %r, 1
  ret %_imaxdiv_t %tmp1
}

define i64 @_imaxdiv_quot(ptr nocapture readonly %a0) #0 {
entry:
  %t0 = getelementptr %_imaxdiv_t, ptr %a0, i32 0, i32 0
  %t1 = load i64, ptr %t0, align 8
  ret i64 %t1
}

define i64 @_imaxdiv_rem(ptr nocapture readonly %a0) #0 {
entry:
  %t0 = getelementptr %_imaxdiv_t, ptr %a0, i32 0, i32 1
  %t1 = load i64, ptr %t0, align 8
  ret i64 %t1
}

attributes #0 = { alwaysinline nounwind }
`