// cstdlib.cx
// C 标准库的通用工具，对应 <stdlib.h>
// size_t → ulong，ptrdiff_t → long，wchar_t → int，long long → long（LP64 下同宽）

extern "C" {
    // 数值转换
    atof(const char-* nptr) double r{}
    atoi(const char-* nptr) int r{}
    atol(const char-* nptr) long r{}
    atoll(const char-* nptr) long r{}
    strtol(const char-* nptr char-** endptr int base) long r{}
    strtoll(const char-* nptr char-** endptr int base) long r{}
    strtoul(const char-* nptr char-** endptr int base) ulong r{}
    strtoull(const char-* nptr char-** endptr int base) ulong r{}
    strtof(const char-* nptr char-** endptr) float r{}
    strtod(const char-* nptr char-** endptr) double r{}
    // strtold 需要 long double，clux 无此类型，不声明

    // 伪随机序列
    rand() int r{}
    srand(uint seed) {}

    // 内存分配：malloc 是关键字，由 `T{n} malloc` 表达，不声明；
    // free 也不声明：它是 malloc 类的内置方法，重复声明会与生成的 free 撞名
    calloc(ulong nmemb ulong size) void-* r{}
    realloc(void-* ptr ulong size) void-* r{}
    aligned_alloc(ulong alignment ulong size) void-* r{}

    // 进程与环境
    atexit($(void)void func) int r{}
    at_quick_exit($(void)void func) int r{}
    exit(int status) {}
    _Exit(int status) {}
    quick_exit(int status) {}
    abort() {}
    getenv(const char-* name) char-* r{}
    system(const char-* string) int r{}

    // 搜索与排序：比较器类型里的 const 限定不受支持，故用 $(void-* void-*)int
    bsearch(const void-* key const void-* base ulong nmemb ulong size $(void-* void-*)int compar) void-* r{}
    qsort(void-* base ulong nmemb ulong size $(void-* void-*)int compar) {}

    // 整数运算：div/ldiv/lldiv 返回聚合类型，extern 不支持，不声明
    abs(int j) int r{}
    labs(long j) long r{}
    llabs(long j) long r{}

    // 多字节与宽字符转换：wchar_t 在 Linux 上为 int
    mblen(const char-* s ulong n) int r{}
    mbtowc(int-* pwc const char-* s ulong n) int r{}
    wctomb(char-* s int wc) int r{}
    mbstowcs(int-* pwcs const char-* s ulong n) ulong r{}
    wcstombs(char-* s const int-* pwcs ulong n) ulong r{}
}