// cstdlib.cx
// C 标准库的通用工具，对应 <stdlib.h>
// ptrdiff_t → long，long long → long（LP64 下同宽）

import cstddef    // size_t, ptrdiff_t, NULL

extern "C" {
    // 数值转换
    atof(const char-* nptr) double r{}
    atoi(const char-* nptr) int r{}
    atol(const char-* nptr) long r{}
    atoll(const char-* nptr) long r{}
    strtol(const char-* nptr char-** endptr int base) long r{}
    strtoll(const char-* nptr char-** endptr int base) long r{}
    strtoul(const char-* nptr char-** endptr int base) ulong r{}
    strtoull(const char-* nptr char-** endptr int base) ulong r{}
    strtof(const char-* nptr char-** endptr) float r{}
    strtod(const char-* nptr char-** endptr) double r{}
    // strtold 需要 long double，clux 无此类型

    // 伪随机序列
    rand() int r{}
    srand(uint seed) {}

    // 内存分配
    // malloc / free 不声明：malloc 是关键字，free 是 malloc 类的内置方法
    calloc(size_t nmemb size_t size) void-* r{}
    realloc(void-* ptr size_t size) void-* r{}
    aligned_alloc(size_t alignment size_t size) void-* r{}

    // 进程与环境
    atexit($(void)void func) int r{}
    at_quick_exit($(void)void func) int r{}
    exit(int status) {}
    _Exit(int status) {}
    quick_exit(int status) {}
    abort() {}
    getenv(const char-* name) char-* r{}   // 返回只读字符串，clux 无 const
    system(const char-* string) int r{}

    // 搜索与排序
    bsearch(const void-* key const void-* base size_t nmemb size_t size $(void-* void-*)int compar) void-* r{}
    qsort(void-* base size_t nmemb size_t size $(void-* void-*)int compar) {}

    // 整数运算
    abs(int j) int r{}
    labs(long j) long r{}
    llabs(long j) long r{}   // long long 在 LP64 下同 long

    // mblen/mbtowc/wctomb/mbstowcs/wcstombs 不做，clux 无宽字符
}