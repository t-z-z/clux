// cstring.cx
// C 字符串与内存块操作，对应 <string.h>
import cstddef

extern "C" {
    // 内存块
    memcpy(void-* dest void-* src size_t n) void-* r{}
    memmove(void-* dest void-* src size_t n) void-* r{}
    memset(void-* s int c size_t n) void-* r{}
    memcmp(void-* p1 void-* p2 size_t n) int r{}
    memchr(void-* s int c size_t n) void-* r{}

    // 字符串复制与拼接
    strcpy(char-* dest char-* src) char-* r{}
    strncpy(char-* dest char-* src size_t n) char-* r{}
    strcat(char-* dest char-* src) char-* r{}
    strncat(char-* dest char-* src size_t n) char-* r{}

    // 比较与转换
    strcmp(char-* s1 char-* s2) int r{}
    strncmp(char-* s1 char-* s2 size_t n) int r{}
    strcoll(char-* s1 char-* s2) int r{}
    strxfrm(char-* dest char-* src size_t n) size_t r{}

    // 查找与切分
    strchr(char-* s int c) char-* r{}
    strrchr(char-* s int c) char-* r{}
    strpbrk(char-* s1 char-* s2) char-* r{}
    strstr(char-* haystack char-* needle) char-* r{}
    strcspn(char-* s1 char-* s2) size_t r{}
    strspn(char-* s1 char-* s2) size_t r{}
    strtok(char-* str char-* delim) char-* r{}

    // 长度与错误描述
    strlen(char-* s) size_t r{}
    strnlen(char-* s size_t maxlen) size_t r{}
    strerror(int errnum) char-* r{}
}