// cfloat.cx
// C 浮点特性，对应 <float.h>
// 目标平台：x86_64 Linux
// clux 无 long double，LDBL_* 与 DECIMAL_DIG 不提供

exprdef FLT_RADIX = 2

exprdef FLT_MANT_DIG = 24
exprdef DBL_MANT_DIG = 53

exprdef FLT_DIG = 6
exprdef DBL_DIG = 15

exprdef FLT_MIN_EXP = -125
exprdef DBL_MIN_EXP = -1021

exprdef FLT_MIN_10_EXP = -37
exprdef DBL_MIN_10_EXP = -307

exprdef FLT_MAX_EXP = 128
exprdef DBL_MAX_EXP = 1024

exprdef FLT_MAX_10_EXP = 38
exprdef DBL_MAX_10_EXP = 308

exprdef FLT_MAX = 3.40282347e+38
exprdef DBL_MAX = 1.7976931348623157e+308

exprdef FLT_EPSILON = 1.19209290e-7
exprdef DBL_EPSILON = 2.2204460492503131e-16

exprdef FLT_MIN = 1.17549435e-38
exprdef DBL_MIN = 2.2250738585072014e-308

exprdef FLT_EVAL_METHOD = 0
exprdef FLT_ROUNDS = 1