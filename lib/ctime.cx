// ctime.cx
// C 时间日期，对应 <time.h>

import cstddef

typedef time_t = long
typedef clock_t = long

exprdef CLOCKS_PER_SEC = 1000000

// C 函数
extern "C" {
    clock() clock_t r{}
    time(time_t-* timer) time_t r{}
    difftime(time_t t1 time_t t0) double r{}
    mktime(tm-* timeptr) time_t r{}
    localtime(time_t-* timer) tm-* r{}
    gmtime(time_t-* timer) tm-* r{}
    asctime(tm-* timeptr) char-* r{}
    ctime(time_t-* timer) char-* r{}
    strftime(char-* s size_t maxsize char-* format tm-* timeptr) size_t r{}
}

// LLVMIR 符号声明
extern "LLVMIR" {
    tm{}
    tm_sec(tm-* p) int r{}
    tm_min(tm-* p) int r{}
    tm_hour(tm-* p) int r{}
    tm_mday(tm-* p) int r{}
    tm_mon(tm-* p) int r{}
    tm_year(tm-* p) int r{}
    tm_wday(tm-* p) int r{}
    tm_yday(tm-* p) int r{}
    tm_isdst(tm-* p) int r{}
}

// IR 实现
keep `
%tm = type {i32, i32, i32, i32, i32, i32, i32, i32, i32, i64, ptr}

define i32 @tm_sec(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 0
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_min(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 1
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_hour(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 2
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_mday(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 3
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_mon(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 4
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_year(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 5
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_wday(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 6
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_yday(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 7
    %v = load i32, ptr %q
    ret i32 %v
}

define i32 @tm_isdst(ptr %p) #0 {
    %q = getelementptr %tm, ptr %p, i32 0, i32 8
    %v = load i32, ptr %q
    ret i32 %v
}

attributes #0 = { alwaysinline nounwind }
`