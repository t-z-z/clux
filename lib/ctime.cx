// ctime.cx
// C 时间与日期，对应 <time.h>
// time_t / clock_t → long，struct tm 用 tm 表达：字段名与顺序同 C，访问用 `p-*.tm_year`

tm {
    pub int tm_sec
    pub int tm_min
    pub int tm_hour
    pub int tm_mday
    pub int tm_mon
    pub int tm_year
    pub int tm_wday
    pub int tm_yday
    pub int tm_isdst
    pub long tm_gmtoff
    pub char-* tm_zone
}

extern "C" {
    // 取时
    clock() long r{}
    time(long-* timer) long r{}
    difftime(long time1 long time2) double r{}

    // 转换
    asctime(const tm-* timeptr) char-* r{}
    ctime(const tm-* timeptr) char-* r{}
    gmtime(const long-* timer) tm-* r{}
    localtime(const long-* timer) tm-* r{}
    mktime(tm-* timeptr) long r{}
    strftime(char-* s ulong maxsize const char-* format const tm-* timeptr) ulong r{}
}