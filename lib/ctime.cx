// ctime.cx
// C 时间与日期，对应 <time.h>
// time_t / clock_t → long，struct tm 用 tm 表达：字段名与顺序同 C，访问用 `p-*.tm_year`

tm {
    pub:
    int tm_sec
    int tm_min
    int tm_hour
    int tm_mday
    int tm_mon
    int tm_year
    int tm_wday
    int tm_yday
    int tm_isdst
    long tm_gmtoff
    char-* tm_zone
    long tm_gmtoff      // glibc 扩展
    char-* tm_zone      // glibc 扩展
}

extern "C" {
    // 取时
    clock() long r{}
    time(long-* timer) long r{}
    difftime(long time1 long time2) double r{}

    // 转换
    asctime(const tm-* timeptr) char-* r{}
    ctime(const tm-* timeptr) char-* r{}
    gmtime(const long-* timer) tm-* r{}
    localtime(const long-* timer) tm-* r{}
    mktime(tm-* timeptr) long r{}
    strftime(char-* s size_t maxsize const char-* format const tm-* timeptr) size_t r{}
}