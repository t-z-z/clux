// 短数组字面量用最后一个元素补齐，空字面量按零初始化，不能留未初始化元素
main() var int r {
    r = 0
    int[4] a = [1 2]
    if a[0] != 1 { r = 1 return }
    if a[1] != 2 { r = 2 return }
    if a[2] != 2 { r = 3 return }
    if a[3] != 2 { r = 4 return }

    int[3] b = []
    if b[0] != 0 { r = 5 return }
    if b[1] != 0 { r = 6 return }
    if b[2] != 0 { r = 7 return }

    int[2][2] c = [[1], [3]]
    if c[0][0] != 1 { r = 8 return }
    if c[0][1] != 1 { r = 9 return }
    if c[1][0] != 3 { r = 10 return }
    if c[1][1] != 3 { r = 11 return }
}
