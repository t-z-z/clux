// 函数体内的 typedef / exprdef：和局部量一样登记进当前作用域，只对其后的代码生效，
// 内层块可遮蔽外层
import cstdio

exprdef base = 7

main() int r {
    typedef wide = long
    exprdef bumped = base + 1
    wide a = 5
    printf("%ld %ld\n", a, bumped)
    {
        typedef wide = int
        exprdef bumped = 100
        wide b = 6
        printf("%d %d\n", b, bumped)
    }
    // 出了内层块，外层别名重新生效
    wide c = 8
    printf("%ld %ld\n", c, bumped)
    r = 0
}