// 定长数组与 C 定长数组一致：存储内联、整体拷贝、可按值传参与返回
extern "c" { putchar(int c) int r {} }
swap(var int[3] a, var int[3] b) {
    int[3] t = a
    a = b
    b = t
}
make() int[2] r {
    int[2] x = [4 5]
    r = x
}
main() int r {
    int[3] a = [1 2 3]
    int[3] b = [7 8 9]
    swap(a, b)
    for var int i = 0; i < a.len; i += 1 { putchar(a[i] + 48) }
    putchar(10)
    int[2] m = make()
    putchar(m[0] + 48)
    putchar(m[1] + 48)
    putchar(10)
    r = 0
}
