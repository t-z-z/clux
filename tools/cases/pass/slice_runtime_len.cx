// int{n}：长度在运行期给出；存储默认 alloca，malloc 修饰则堆分配且不自动释放
extern "c" { putchar(int c) int r {} }
main() int r {
    int n = 3
    int{n} a = [1 2 3]
    malloc int{n} h = [4 5 6]
    putchar(a.len + 48)
    putchar(h.len + 48)
    for int i = 0; i < a.len; i += 1 { putchar(a[i] + 48) }
    for int j = 0; j < h.len; j += 1 { putchar(h[j] + 48) }
    int{} b = a
    putchar(b.len + 48)
    putchar(10)
    r = a.len + h.len
}
