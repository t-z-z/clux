// 参数打包的构造调用只计一次持有：返回值落进调用方 sret 槽是"搬进调用方
// 存储"，不是复制出新的一份持有，不该再计一次 REF
import cstdio
Res {
    pub var int n = 0

    pub REF { n += 1 }
    pub DEREF { n -= 1 }
}
Owner {
    pub Res-* held

    pub INIT(Res-* p) { self.held = p }
}
conversion(Owner a) Owner b {
    b = Owner(a.held)
}
main() var int r {
    Res v = Res()
    Owner o = Owner(v-&)
    Owner q = o
    r = 0
    // 一次持有 +1（INIT 内的字段赋值），搬运与返回不计
    if v.n != 2 { r = 1 }
    return
}
