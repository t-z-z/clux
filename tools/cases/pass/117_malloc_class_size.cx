// malloc 类的分配量由 LLVM 按真实布局算出：聚合字段与对齐都不能漏算
malloc @Box {
    pub char tag
    pub int[3] data = [4 5 6]
    pub long total
    pub INIT() {
        self.tag = 3
        self.total = self.data[0]
    }
}
malloc @Crate {
    pub Box inner
    pub INIT() { self.inner = Box() }
}
main() int r {
    Crate c = Crate()
    r = int(c.inner.total)
    return
}
