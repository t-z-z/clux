// 类型位置默认支持括号：'(T)-*'、'(T[N])'；tp/ep 断言后面一定是类型/表达式
import cstdio

namespace demo {
    tag() int r { r = 7 }
}

Node {
    pub (int)-* p
    pub tp ($(int)int)-* fpp
}

apply((int)-* q) int r { r = q[0] }

main() int r {
    int x = 42
    long w = 5
    tp (int)-* p = x-&
    tp (int)-* q = p
    tp (int[3]) arr = [1 2 3]
    int y = tp (int)(w)
    Node n
    n.p = q
    ep printf("%d %d %d %d %d\n", p[0], q[0], arr[2], y, apply(q) + demo::tag())
    r = 0
}