// const 的一次性初始化按路径计：if/else 各赋一次是两条路径各一次，
// 不算二次写入。返回量、局部量、类 const 字段同理
C {
    pub:
    const int x
    INIT(bool f) {
        if f {
            self.x = 1
        } else {
            self.x = 2
        }
    }
}
pick(bool f) const int r {
    if f {
        r = 1
    } else {
        r = 2
    }
    return
}
main() int r {
    if pick(0) > 1 {
        r = 1
    } else {
        r = 0
    }
    const int a
    if r != 0 {
        a = 1
    } else {
        a = 2
    }
    r = r + a
    C c = C(r != 0)
    r = r + c.x
    return
}