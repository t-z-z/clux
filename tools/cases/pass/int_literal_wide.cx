// 无后缀整数字面量的类型按值推导：能装进 i64 就是有符号，装不下才退到
// 无符号与 128 位。收窄到更小的类型时由范围检查拦下。
// 覆盖 issue 里静默截断的例子：4294967295 曾被 sext 成 -1。
import cstdio

main() int r {
    ulong u = 4294967295
    long v = 12345678901
    ulong u2 = 18446744073709551615
    long add = 4294967295 + 1
    printf("%lu\n%ld\n%lu\n%ld\n", u, v, u2, add)
    r = 0
}