// 类字段按值内嵌：字段存储就是嵌套对象本身，随宿主对象一起活着。
// `self.item = Node(7)` 就地构造进字段，不再存 INIT 栈帧上的临时实例地址，
// 因此 h1.item 不受第二次构造的影响。
Node {
    pub int v = 0
    pub int w = 0

    pub INIT(int s) { self.v = s }
}
Holder {
    pub Node item

    pub INIT(int s) { self.item = Node(s) }
}
main() int r {
    r = 0
    Holder h1 = Holder(7)
    Holder h2 = Holder(999)
    if h1.item.v != 7 { r = 1 }
    if h2.item.v != 999 { r = r + 10 }
    if h1.item == h2.item { r = r + 100 }
    h1.item.v = 42
    if h2.item.v != 999 { r = r + 1000 }
    return
}
