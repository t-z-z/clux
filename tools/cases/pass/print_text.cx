extern "c" { putchar(int c) int r {} }
print(char-* s, int n) {
    for int i = 0; i < n; i += 1 { putchar(int(s[i])) }
}
main() int r {
    char[] a = "hello world"
    char[] b = "safe text"
    char[] nl = "\n"
    print(a, a.len)
    print(nl, nl.len)
    print(b, b.len)
    print(nl, nl.len)
    r = 0
}
