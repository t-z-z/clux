{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "C:\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "${workspaceFolder}\\src\\diagnostic.cpp",
                "${workspaceFolder}\\src\\lexer.cpp",
                "${workspaceFolder}\\src\\parser.cpp",
                "${workspaceFolder}\\src\\semantic.cpp",
                "${workspaceFolder}\\src\\translator.cpp",
                "${workspaceFolder}\\src\\main.cpp",
                "-o",
                //"${fileDirname}\\${fileBasenameNoExtension}.exe"
                "${workspaceFolder}\\bin\\voic.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}