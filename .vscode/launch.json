    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Voice Compiler",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/volc.exe",
            "args": ["${workspaceFolder}/test.vo", "-o", "test.exe"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "miDebuggerPath": "lldb",
            "setupCommands": [
                {
                    "description": "为 lldb 启用整齐打印",
                    "text": "settings set target.pretty-print-values true",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
